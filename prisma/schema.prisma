// Prisma schema — AI Finance Manager
// SQLite for MVP; swap provider to "postgresql" + add pgvector for prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  createdAt     DateTime       @default(now())
  profile       UserProfile?
  accounts      Account[]
  goals         SavingsGoal[]
  conversations Conversation[]
  transactions  Transaction[]
}

model UserProfile {
  id                  Int     @id @default(autoincrement())
  userId              Int     @unique
  monthlyIncome       Int
  emergencyFundTarget Int
  riskTolerance       String  @default("medium") // low | medium | high
  dependents          Int     @default(0)
  notesAboutSelf      String?
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           Int           @id @default(autoincrement())
  userId       Int
  name         String
  type         String // checking | savings | cash
  balance      Int           @default(0)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  parent       String? // Essentials | Lifestyle | Obligations | Anomaly
  isEssential  Boolean       @default(false)
  isHighRisk   Boolean       @default(false)
  transactions Transaction[]
}

model Transaction {
  id          Int       @id @default(autoincrement())
  userId      Int
  accountId   Int
  categoryId  Int?
  date        DateTime
  amount      Int // signed: positive=income, negative=expense, transfer can be either
  type        String // income | expense | transfer
  merchant    String?
  description String?
  isAnomaly   Boolean   @default(false)
  embedding   Bytes?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
}

model SavingsGoal {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Int
  targetDate    DateTime
  currentAmount Int      @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int
  startedAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           String // user | assistant | tool
  content        String
  toolCalls      String?
  toolResults    String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
